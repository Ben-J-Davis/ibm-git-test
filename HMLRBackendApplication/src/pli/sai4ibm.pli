 SAI4IBM:PROC OPTIONS(MAIN);                                            00080002
                                                                        00090000
 /*********************************************************************/00100000
 /* SAMPLE DB2 PROGRAM FOR IBM                                        */00110000
 /*********************************************************************/00376000
                                                                        00380000
 /*********************************************************************/00390000
 /*                           SQL INCLUDES                            */00400000
 /*********************************************************************/00410000
                                                                        00420000
 /* EXEC SQL INCLUDE DB2T687P;   /* T_DX_AVAIL   */                     00430001
  DCL 1 DCLT687,                                                        00440001
       2 DX_AVAIL_IND  CHAR(1);                                         00441001
  EXEC SQL INCLUDE SQLCA;      /* COMMAREA     */                       00450000
                                                                        00460000
 /********************************************************************/ 00470000
 /*                      DECLARE FILES                               */ 00480000
 /********************************************************************/ 00490000
  DCL SAIFILE FILE RECORD OUTPUT ENV(CTLASA);                           00500000
                                                                        00510000
 /*********************************************************************/00520000
 /*   DECLARATIONS FOR REPORT                                         */00530000
 /*********************************************************************/00540000
                                                                        00550000
  DCL 1 HEADER,                                                         00560000
       2 ASA    CHAR(1)   INIT('1'),                                    00570000
       2 F1     CHAR(10)  INIT(''),                                     00580000
       2 HEAD1  CHAR(44)  INIT                                          00590000
                   ('STATISTICS FOR DUMMY PROGRAM'),                    00600000
       2 F2     CHAR(19)  INIT(''),                                     00610000
       2 HDTE,                                                          00620000
        3 HDY    CHAR(2),                                               00630000
        3 FS1    CHAR(1)  INIT('/'),                                    00640000
        3 HMNH   CHAR(2),                                               00650000
        3 FS2    CHAR(1)  INIT('/'),                                    00660000
        3 HYR    CHAR(4),                                               00670000
       2 F3     CHAR(3)   INIT(''),                                     00680000
       2 HTME   CHAR(8),                                                00690000
       2 F4     CHAR(38)  INIT('');                                     00700000
                                                                        00710000
  DCL CURR_DATE      CHAR(10) BASED(ADDR(HDTE));                        00720000
  DCL CURR_TIME      CHAR(8) BASED(ADDR(HTME));                         00730000
  DCL WORK_TIMESTAMP CHAR(26) INIT ('');                                00740000
                                                                        00750000
  DCL 1 LINE1,                                                          00760000
       2 ASA    CHAR(1)   INIT(' '),                                    00770000
       2 F1     CHAR(10)  INIT(''),                                     00780000
       2 PRGM   CHAR(16)  INIT('PROGRAM: SAI4IBM'),                     00790000
       2 F2     CHAR(20)   INIT(''),                                    00800000
       2 F3     CHAR(86) INIT('');                                      00810000
                                                                        00820000
  DCL 1 LINE_R,                                                         00830000
       2 ASA    CHAR(1)   INIT('-'),                                    00840000
       2 F1     CHAR(10)  INIT(''),                                     00850000
       2 TEXT1  CHAR(35)                                                00860000
           INIT('DATA FROM T_DX_AVAIL - DX_AVAIL_IND'),                 00870000
       2 F2     CHAR(3)   INIT(' = '),                                  00880000
       2 AVAIL_IND  CHAR(1) INIT(' '),                                  00890000
       2 F4     CHAR(83)  INIT('');                                     00900000
                                                                        00910000
  DCL 1 TRAILER,                                                        01010000
       2 ASA    CHAR(1)   INIT('-'),                                    01020000
       2 F1     CHAR(43)  INIT(''),                                     01030000
       2 TEXT   CHAR(13)  INIT('END OF REPORT'),                        01040000
       2 F2     CHAR(76)  INIT('');                                     01050000
                                                                        01200000
 /*********************************************************************/01210000
 /*   DECLARATIONS OF DB2 ERROR HANDLING                              */01220000
 /*********************************************************************/01230000
                                                                        01240000
  DCL GBLERR ENTRY EXTERNAL;                                            01250000
  DCL PROG_NAME    CHAR(8)   INIT('SAI4IBM');                           01260000
  DCL CALL_NO      CHAR(2)   INIT('  ');                                01270000
  DCL PART_RECORD  CHAR(100) INIT('');                                  01280000
                                                                        01290000
 /*********************************************************************/01300000
 /*   PROGRAM DECLARATIONS                                            */01310000
 /*********************************************************************/01320000
                                                                        01330000
  DCL (ADDR,DATETIME,NULL,PLIDUMP) BUILTIN;                             01340000
                                                                        01390000
  /*************************************************************/       01400000
  /*  START OF PROGRAM                                         */       01410000
  /*************************************************************/       01420000
                                                                        01430000
   ON ERROR BEGIN;                                                      01440000
     ON ERROR SYSTEM;                                                   01450000
       BEGIN;                                                           01460000
         CALL PLIDUMP ('TFSB');                                         01470000
       END;                                                             01480000
     END;                                                               01490000
                                                                        01500000
                                                                        01510000
   SQLCA = '';                                                          01520000
                                                                        01530000
 /**************************************************************/       01540000
 /*  WRITE HEADER AND SUB HEADER LINES                         */       01550000
 /**************************************************************/       01560000
                                                                        01570000
   EXEC SQL                                                             01580000
     SET :CURR_DATE = CURRENT DATE,                                     01590000
         :CURR_TIME = CURRENT TIME                                      01600000
   ;                                                                    01620000
                                                                        01630000
   OPEN FILE(SAIFILE);                                                  01640000
                                                                        01650000
   WRITE FILE (SAIFILE) FROM (HEADER);                                  01660000
   WRITE FILE (SAIFILE) FROM (LINE1);                                   01670000
                                                                        01680000
                                                                        01720000
 /**************************************************************/       01730000
 /*  DELETE ROWS THAT ARE OLDER THAN 6 MONTHS                  */       01740000
 /**************************************************************/       01750000
                                                                        01760000
 /*  DELETE ROWS FROM V_SERV_RESULT_INFO */                             01770000
   CALL_NO = '02';                                                      01780000
   DCLT687.DX_AVAIL_IND = '?';                                          01790000
   CALL GET_DX_AVAIL;                                                   01800000
                                                                        01880000
   AVAIL_IND = DCLT687.DX_AVAIL_IND;                                    01900000
   WRITE FILE (SAIFILE) FROM (LINE_R);                                  01910000
                                                                        01930000
                                                                        01940000
 /*   WRITE TRAILER LINES  */                                           01950000
   WRITE FILE (SAIFILE) FROM (TRAILER);                                 01960000
   CLOSE FILE(SAIFILE);                                                 01970000
                                                                        01980000
  /*******************************************************/             01990000
  /*       START OF SAI4IBM PROCEDURES                   */             02000000
  /*******************************************************/             02010000
                                                                        02020000
1GET_DX_AVAIL: PROC;                                                    02030000
                                                                        02040000
            CALL_NO = '03';                                             02050000
            PART_RECORD = ('FAILED TO SELECT FROM T_DX_AVAIL');         02060000
            EXEC SQL                                                    02070000
                 SELECT DX_AVAIL_IND                                    02080000
                  INTO  :DCLT687.DX_AVAIL_IND                           02090000
                  FROM  T_DX_AVAIL;                                     02100000
                                                                        02110000
            IF SQLCODE  < 0 THEN                                        02120003
             DO                                                         02120103
              DISPLAY('-----DB2 ERROR DETECTED-----');                  02121003
              DISPLAY('SQLCODE: ' || SQLCODE);                          02122003
              CALL DB2ERROR;                                            02130003
              STOP;                                                     02140003
             END;                                                       02190003
 END;                                                                   02200000
                                                                        02210000
                                                                        02540000
                                                                        02790000
1DB2ERROR: PROC;                                                        02800000
                                                                        02810000
   /*************************/                                          02820000
   /*   DB2 ERROR ROUTINE   */                                          02830000
   /*************************/                                          02840000
                                                                        02850000
    CALL GBLERR(PROG_NAME,SQLCA,CALL_NO,PART_RECORD);                   02860000
    CALL PLIDUMP('TFSB');                                               02870000
                                                                        02880000
 END;  /* OF DB2ERROR */                                                02890000
                                                                        02900000
 END; /* END OF PROGRAM */                                              02910000
 /* --- STUB TO BYPASS LINKER ERROR --- */                              02920002
 GBLERR: PROC(P1, P2, P3, P4);                                          02930002
   DCL (P1, P2, P3, P4) CHAR(*);                                        02940002
 END GBLERR;                                                            02950002
